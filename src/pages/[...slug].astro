---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getVirtualFs, type FsNode } from "../lib/virtualFs.ts";
import { prerenderPath, pageTitle, pageDescription } from "../lib/prerender.ts";

export const prerender = true;

export async function getStaticPaths() {
  const root = getVirtualFs();
  const paths: { params: { slug: string } }[] = [];

  const walk = (node: FsNode) => {
    if (node.type === "file") {
      paths.push({ params: { slug: node.path.substring(1) } });
    } else if (node.children) {
      const dirSlug = node.path === '/' ? 'index.html' : node.path.substring(1) + '/index.html';
      paths.push({ params: { slug: dirSlug } });
      for (const child of Object.values(node.children)) walk(child);
    }
  };
  walk(root);
  return paths;
}

// Render the page's content at build time so the static HTML carries the
// article body (readable without JS). ContentPane hydrates over it.
const slug = Astro.params.slug ?? 'index.html';
const initial = await prerenderPath('/' + slug);
const title = pageTitle(initial);
const description = pageDescription(initial);
const canonicalPath = initial.kind === 'home' ? '/' : initial.path;
---
<BaseLayout {initial} {title} {description} {canonicalPath} />

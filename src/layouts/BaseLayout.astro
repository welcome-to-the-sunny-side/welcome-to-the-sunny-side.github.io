---
import '../styles/global.css';
import TerminalPane from "../components/TerminalPane.svelte";
import ContentPane from "../components/ContentPane.svelte";
import MobileNav from "../components/MobileNav.svelte";
import type { InitialContent } from "../lib/prerender.ts";

interface Props {
  initial?: InitialContent | null;
  title?: string;
  description?: string | null;
  canonicalPath?: string | null;
  markdownPath?: string | null;
}

const {
  initial = null,
  title = 'Welcome to the Sunny Side!',
  description = null,
  canonicalPath = null,
  markdownPath = null,
} = Astro.props;

const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const canonical = canonicalPath ? site + canonicalPath : null;
---
<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} />}
    <link rel="icon" href="/favicon.ico" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FDGES615HV"></script>
        <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-FDGES615HV');
        </script>
</head>
  <body class="h-full">
    <!-- Below md the document itself scrolls (main just grows): iOS WebKit lags
         scrolling a math-heavy <main> that holds nested scroll areas (code,
         spoilers). From md up, main is the scroll container next to the terminal. -->
    <div class="min-h-[100dvh] md:h-screen w-screen grid grid-cols-1 grid-rows-[auto_1fr] md:grid-cols-[1fr_auto] md:grid-rows-1">
      <!-- Mobile breadcrumb nav -->
      <div class="md:hidden sticky top-0 z-10">
        <MobileNav client:load />
      </div>

      <!-- Content -->
      <main class="overflow-x-clip md:overflow-x-hidden md:overflow-y-auto bg-surface text-text transition-colors duration-150 ease-retro min-h-0">
        <ContentPane client:load {initial} />
      </main>

      <!-- Terminal (desktop only) -->
      <aside class="hidden md:block">
        <TerminalPane client:load />
      </aside>
    </div>
  </body>
</html>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getVirtualFs, type FsNode } from "../lib/virtualFs.ts";
import { prerenderPath, pageTitle, pageDescription } from "../lib/prerender.ts";

export const prerender = true;

export async function getStaticPaths() {
  const root = getVirtualFs();
  const paths: { params: { slug: string } }[] = [];

  const walk = (node: FsNode) => {
    if (node.type === "file") {
      paths.push({ params: { slug: node.path.substring(1) } });
    } else if (node.children) {
      const dirSlug = node.path === '/' ? 'index.html' : node.path.substring(1) + '/index.html';
      paths.push({ params: { slug: dirSlug } });
      for (const child of Object.values(node.children)) walk(child);
    }
  };
  walk(root);
  return paths;
}

// Render the page's content at build time so the static HTML carries the
// article body (readable without JS). ContentPane hydrates over it.
const slug = Astro.params.slug ?? 'index.html';
const initial = await prerenderPath('/' + slug);
const title = pageTitle(initial);
const description = pageDescription(initial);
const canonicalPath = initial.kind === 'home' ? '/' : initial.path;
// Markdown source for agents (src/pages/[...slug].md.ts), linked from <head> only.
const markdownPath = initial.kind === 'md' ? initial.path.replace(/\.html$/, '.md') : null;

// The article HTML (typeset math included) is large; keep it out of the
// island's serialized props, which would ship it a second time. Astro skips
// non-enumerable keys when serializing, but the server render still reads it,
// and ContentPane picks the HTML back up from the DOM on the client.
const pageInitial = { ...initial };
if (pageInitial.kind === 'md') {
  Object.defineProperty(pageInitial, 'html', { value: initial.kind === 'md' ? initial.html : '', enumerable: false });
}
---
<BaseLayout initial={pageInitial} {title} {description} {canonicalPath} {markdownPath} />
